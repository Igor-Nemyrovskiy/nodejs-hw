{
  "openapi": "3.0.3",
  "info": {
    "title": "Notes API",
    "description": "API for working with notes. Node.js homework project.",
    "version": "1.0.0",
    "license": {
      "name": "ISC",
      "url": "https://opensource.org/license/ISC"
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Notes",
      "description": "Operations with notes"
    },
    {
      "name": "Testing",
      "description": "Testing server errors"
    }
  ],
  "paths": {
    "/notes": {
      "get": {
        "tags": ["Notes"],
        "summary": "Get all notes",
        "operationId": "getAllNotes",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                },
                "example": {
                  "message": "Retrieved all notes"
                }
              }
            }
          }
        }
      }
    },
    "/notes/{noteId}": {
      "get": {
        "tags": ["Notes"],
        "summary": "Get note by ID",
        "operationId": "getNoteById",
        "parameters": [
          {
            "name": "noteId",
            "in": "path",
            "required": true,
            "description": "ID of the note",
            "schema": {
              "type": "string"
            },
            "example": "123"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                },
                "example": {
                  "message": "Retrieved note with ID: 123"
                }
              }
            }
          }
        }
      }
    },
    "/test-error": {
      "get": {
        "tags": ["Testing"],
        "summary": "Simulate a server error",
        "operationId": "simulateServerError",
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                },
                "example": {
                  "message": "Simulated server error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MessageResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
